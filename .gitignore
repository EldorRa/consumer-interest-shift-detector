# ---------------------------------------------------------------------------
# Source corpus. Not redistributed: ~94 MB of third-party data, and the
# X/Twitter Developer Agreement permits sharing tweet IDs, not hydrated text.
# See data/README.md for where to obtain it.
# ---------------------------------------------------------------------------
Olympics_Tokyo_tweets.csv
data/*.csv
data/*.zip

# ---------------------------------------------------------------------------
# The labelled coding sheet contains full tweet text, so it is excluded for
# the same reason. It is also the one artefact that cannot be regenerated by
# running code - keep a backup OUTSIDE this folder.
# ---------------------------------------------------------------------------
outputs/coding_sheet*.csv

# NOTE: cache/ is deliberately NOT ignored. Google Trends normalises each
# series to the maximum of the requested window, so an uncached rerun on a
# different day returns different values. The cache is what makes the
# reported numbers reproducible.

# Environments
venv*/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
